{
	"name": "vscode-memory",
	"version": "0.0.1",
	"description": "Persistent shared memory extension for pi",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check --write src tests",
		"format": "biome format --write ."
	},
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.8.0",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^3.2.7",
		"typescript": "^5.5.0",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"typebox": "^1.3.16"
	}
}
